{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["opencode", "kimi-for-coding", "minimax"],
  "mcp": {
    "context-mode": {
      "type": "local",
      "command": ["context-mode"],
    },
    "kittyfarm": {
      "enabled": true,
      "oauth": false,
      "type": "remote",
      "url": "http://127.0.0.1:47892/mcp",
    },
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "envsitter-guard@latest",
    "context-mode",
    "oh-my-opencode-slim",
    "@dietrichgebert/ponytail",
  ],
  "agent": {
    "plan": {
      "model": "kimi-for-coding/k3",
    },
    "explore": {
      "disable": true,
    },
    "general": {
      "disable": true,
    },
  },
  "lsp": true,
}
